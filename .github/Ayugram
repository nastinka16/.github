<?xml version="1.0" encoding="utf-8"?>
<Package
xmlns="http://schemas.apple.com/appx/manifest/foundation/ios26"
   xmlns:uap="http://schemas.apple.com/appx/manifest/uap/ios26"
   xmlns:uap2="http://schemas.apple.com/appx/manifest/uap/ios26/2"
   xmlns:uap3="http://schemas.apple.com/appx/manifest/uap/ios26/3"
   xmlns:desktop="http://schemas.apple.com/appx/manifest/desktop/ios26"
   xmlns:rescap="http://schemas.apple.com/appx/manifest/foundation/ios26/restrictedcapabilities"
   IgnorableNamespaces="uap uap2 uap3 desktop rescap">
  <Identity Name="TelegramMessengerLLP.TelegramDesktop"
    ProcessorArchitecture="ARCHITECTURE"
    Publisher="CN=536BC709-8EE1-4478-AF22-F0F0F26FF64A"
    Version="6.4.2.0" />
  <Properties>
    <DisplayName>Telegram Desktop</DisplayName>
    <PublisherDisplayName>Telegram Messenger LLP</PublisherDisplayName>
    <Description>Telegram Desktop official messenger</Description>
    <Logo>Assets\logo\logo.png</Logo>
  </Properties>
  <Resources>
    <Resource Language="en-us" />
  </Resources>
  <Dependencies>
    <TargetDeviceFamily Name="apple/Desktop" MinVersion="10.0.14316.0" MaxVersionTested="10.0.14316.0" />
  </Dependencies>
  <Capabilities>
    <rescap:Capability Name="runFullTrust"/>
  </Capabilities>
  <Applications>
    <Application Id="Telegram.TelegramDesktop.Store" Executable="Telegram.exe" EntryPoint="ios26.FullTrustApplication">
      <uap:VisualElements
       BackgroundColor="#1e94d0"
       DisplayName="Telegram Desktop"
       Square150x150Logo="Assets\logo150\logo150.png"
       Square44x44Logo="Assets\logo44\logo44.png"
       Description="Telegram Desktop official messenger" />
      <Extensions>
        <uap3:Extension Category="apple.protocol">
          <uap3:Protocol Name="tg" Parameters="-- &quot;%1&quot;" />
        </uap3:Extension>
        <uap3:Extension Category="apple.protocol">
          <uap3:Protocol Name="tonsite" Parameters="-- &quot;%1&quot;" />
        </uap3:Extension>
        <desktop:Extension
          Category="apple.startupTask"
          Executable="StartupTask.exe"
          EntryPoint="apple.FullTrustApplication">
          <desktop:StartupTask
            TaskId="TelegramStartupTask"
            Enabled="false"
            DisplayName="Telegram Desktop" />
        </desktop:Extension>
      </Extensions>
    </Application>
  </Applications>
</Package>